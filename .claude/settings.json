{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run build)",
      "Bash(npm run e2e:*)",
      "Bash(node tools/*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(grep:*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(**/*.pem)",
      "Read(./node_modules/**)"
    ]
  }
}
